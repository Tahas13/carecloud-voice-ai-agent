# --- Database ---------------------------------------------------------------
# Local dev defaults to SQLite (file ./carecloud.db). On Railway this is
# injected automatically by the PostgreSQL plugin.
DATABASE_URL=sqlite:///./carecloud.db

# --- Vapi (telephony + voice AI platform) -----------------------------------
# Private API key from https://dashboard.vapi.ai -> Settings -> API Keys
VAPI_API_KEY=
# Shared secret we tell Vapi to send in the X-Vapi-Secret header on every
# webhook call, so nobody else can invoke our tool endpoints.
VAPI_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Public (browser-safe) key from the Vapi dashboard + the assistant's ID.
# Both power the dashboard's "Call from browser" button; leave empty to hide it.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Display-only phone number shown on the dashboard.
AGENT_PHONE_NUMBER=+1 (708) 523-1081

# --- OpenAI (optional) --------------------------------------------------------
# Only used by scripts/setup_vapi.py if you want the assistant to bill LLM
# usage to your own OpenAI key instead of Vapi credits.
OPENAI_API_KEY=

# --- App ----------------------------------------------------------------------
# Public HTTPS base URL of this deployed API (no trailing slash).
# Vapi tool calls are sent to {PUBLIC_BASE_URL}/vapi/webhook
PUBLIC_BASE_URL=https://your-app.up.railway.app
LOG_LEVEL=INFO
